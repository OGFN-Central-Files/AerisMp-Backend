# DISCORD
BOT_TOKEN=""
CLIENT_ID=""
GUILD_ID=""
CLIENT_SECRET=""
REDIRECT_URI="http://127.0.0.1:99/auth/discord/callback"
DISCORD_AUTH=true
LOG_WEBHOOK=""

# ADMIN IDS
MODERATOR_1=""
MODERATOR_2=""
MODERATOR_3=""

# MONGODB
MONGO_URI="mongodb://127.0.0.1/test"

# MATCHMAKER
MATCHMAKER_IP="ws://127.0.0.1:8080"
MATCHMAKER_PORT=8080

# Regions (comma-separated). Each needs a matching <REGION>_IP env var.
REGIONS="EU,NAE"

# Format per region: IP:PORT|playlist1,playlist2;IP2:PORT|playlist3
# Omit playlists to make a server a catch-all for that region.
# Multiple servers are load-balanced via round-robin with health checks.
EU_IP="127.0.0.1:7778|playlist_defaultsolo,playlist_defaultduo"
NAE_IP="127.0.0.1:7777|playlist_defaultsolo,playlist_defaultduo,playlist_defaultsquad"

# Custom matchmaking keys: CUSTOM_KEY_<KEYNAME>=IP:PORT
# Example: CUSTOM_KEY_MYCODE=127.0.0.1:7779
# CUSTOM_KEY_MYCODE=""

# Matchmaker tuning
MM_DELAY_CONNECTING=500
MM_DELAY_WAITING=500
MM_DELAY_QUEUED=4000
MM_DELAY_SESSION=1000
MM_QUEUE_TIMEOUT_SEC=120
MM_MAX_QUEUE_SIZE=1000

# How often (ms) to poll for a joinable server
MM_JOINABLE_POLL_MS=2000
# Max time (ms) to wait for a server to become joinable
MM_JOINABLE_WAIT_MS=60000

# Set to "false" to skip TCP health checks (faster but no failover)
MM_HEALTH_CHECK=true
MM_HEALTH_TIMEOUT_MS=2000

# EVENTS
EVENT_TYPE="Arena"

JWT_SECRET="aeris-jwt-secret-do-not-share-change-this"

# BACKEND OPTIONS
BACKEND_NAME="Aeris" 
API_KEY="Aeris"
MAIN_SEASON=9
PORT=3551
BACKEND_IP="0.0.0.0"
XMPP_PORT=70
